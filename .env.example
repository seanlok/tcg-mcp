# tcg-mcp environment configuration — copy to .env and fill in.
#
# .env is gitignored. NEVER commit real tokens to this repo.

# ---- PSA grading provider --------------------------------------------------
# Get a free token at https://www.psacard.com/publicapi
# Required only for tcg_psa_* tools. Other tools work without it.
PSA_API_TOKEN=

# Override the PSA API base URL (testing only). Default is the production API.
# PSA_API_BASE_URL=https://api.psacard.com/publicapi

# ---- Pokemon TCG API pricing provider --------------------------------------
# Optional. Without a key, requests work but at 1000/day, 30/min.
# With a key, default 20000/day. Free key: https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=

# ---- PriceCharting pricing provider ----------------------------------------
# PAID subscription required. Provides graded-card prices (PSA 7-10, BGS, ...).
# https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=

# ---- Storage ---------------------------------------------------------------
# Where to keep the local SQLite database. Default ~/.tcg-mcp/tcg.db
# TCG_DB_PATH=/path/to/your/tcg.db

# ---- HTTP behaviour --------------------------------------------------------
# HTTP_TIMEOUT_SECONDS=30
